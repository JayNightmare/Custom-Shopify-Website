# Shopify
SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2024-04
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2024-04
SHOPIFY_ADMIN_TOKEN=                               # Server-side only, DO NOT expose to client
SHOPIFY_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=
MONGODB_DB=artist_shop

# Auth (NextAuth Email/Magic Link)
AUTH_SECRET=
EMAIL_FROM="Indie Artist <no-reply@domain.com>"
EMAIL_SERVER_HOST=smtp.yourhost.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Optional feature flags
FEATURE_FLAGS_JSON=                                # JSON string e.g. {"previewMode":true}
